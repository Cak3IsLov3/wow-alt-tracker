# Create a client at https://develop.battle.net/access/clients
# and set its redirect URL to exactly the same value as REDIRECT_URI.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/auth/callback

# Signs the session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Fernet key used to encrypt tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty = derived from SECRET_KEY (fine for dev).
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./wow_alt_tracker.db
DEFAULT_REGION=eu

# Automatic sync; 0 = off.
SYNC_INTERVAL_MINUTES=30
