# Maak een client aan op https://develop.battle.net/access/clients
# en zet de redirect-URL daar op exact dezelfde waarde als REDIRECT_URI.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/auth/callback

# Ondertekent de sessiecookie. Genereer: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Fernet-sleutel voor het versleutelen van tokens.
# Genereer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leeg laten = afgeleid van SECRET_KEY (prima voor dev).
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./wow_alt_tracker.db
DEFAULT_REGION=eu

# Automatische sync; 0 = uit.
SYNC_INTERVAL_MINUTES=60
